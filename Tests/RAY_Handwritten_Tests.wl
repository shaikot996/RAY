(* RAY v1.1.2 — human-readable curvature and notebook-style RAW tests. *)
Needs["RAY`"];
ClearAll[t,x,y,z,A,B,P,Q,i,j,hhTests,hhReport];

hhTests={
 VerificationTest[
  (RAYWarpedMetric["HandwrittenWarp4D",{
   {{t},{{-1}},1},{{x},{{1}},Exp[2 A[t]]},
   {{y,z},{{P[y,z],0},{0,Q[y,z]}},Exp[2 B[t]]}},
    "Simplification"->"Simplify"];RAYDimension[]),
  4,TestID->"01-symbolic-warp-4d"
 ],
 VerificationTest[
   Dimensions[RAYRaw["Ricci","dd"]],{4,4},
   TestID->"02-raw-Ricci-is-array"
 ],
 VerificationTest[
   Head[RAYRicci["dd"]]===Head[RAYEinstein["dd"]],
   True,TestID->"03-labeled-Ricci-and-Einstein"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYRicci["dd"],StandardForm],_GridBox],
   True,TestID->"04-Ricci-component-rows"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYEinstein["dd"],StandardForm],_GridBox],
   True,TestID->"05-Einstein-component-rows"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYRicci["dd"],StandardForm],
     SubscriptBox["R",RowBox[{"t","t"}]]],
   True,TestID->"06-Ricci-tt-label"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYRicci["dd"],StandardForm],
     SubscriptBox["R",RowBox[{"y","y"}]]],
   True,TestID->"07-Ricci-yy-label"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYRicci["dd"],StandardForm],
     SubscriptBox["R",RowBox[{"z","z"}]]],
   True,TestID->"08-Ricci-zz-label"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYRicci["dd"],StandardForm],
     TagBox[_FractionBox,"InactiveDTraditional",___]],
   True,TestID->"09-default-partial-Ricci"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYRicci["dd"],StandardForm],
     TagBox[_FractionBox,"InactiveDTraditional",___]],
   True,TestID->"10-partial-derivative-Ricci"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYRicci["dd"],StandardForm],
      TagBox[_FractionBox,"InactiveDTraditional",___]],
   True,TestID->"11-internal-partial-derivatives"
 ],
 VerificationTest[
   Head[RAYRicci["dd","Matrix"]]===Head[RAYReadable[MatrixForm[{{1}}]]],
   True,TestID->"12-optional-full-matrix"
 ],
 VerificationTest[
   SameQ[First[RAYRicci["dd"]//RAW],RAYRaw["Ricci","dd"]],
   True,TestID->"13-RAW-Ricci-full-array"
 ],
 VerificationTest[
   SameQ[First[RAYEinstein["dd"]//RAW],RAYRaw["Einstein","dd"]],
   True,TestID->"14-RAW-Einstein-full-array"
 ],
 VerificationTest[
   SameQ[First[RAYRicci["dd","Matrix"]//RAW],
       RAYRaw["Ricci","dd"]],
   True,TestID->"15-RAW-optional-matrix"
 ],
 VerificationTest[
   TrueQ[FullSimplify[
      First[RAYRicciScalar[]//RAW]-RAYRaw["RicciScalar"]==0]],
   True,TestID->"16-RAW-scalar-original-data"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYRicciScalar[],StandardForm],
     TagBox[_FractionBox,"InactiveDTraditional",___]],
   True,TestID->"17-scalar-partial-B"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYRicciScalar[],StandardForm],
     TagBox[_FractionBox,"InactiveDTraditional",___]],
   True,TestID->"18-scalar-partial-fraction"
 ],
 VerificationTest[
   Module[{text=ToString[ToBoxes[RAYRicciScalar[]//RAW,
      StandardForm],InputForm]},
     StringContainsQ[text,"SuperscriptBox"] &&
       StringContainsQ[text,"["]],
   True,TestID->"19-RAW-standard-prime-box"
 ],
 VerificationTest[
   Module[{code=ToBoxes[
     RAYTensor["V",{RAYUp[i]}]//RAW,StandardForm]},
     !FreeQ[code,RowBox[{"RAYTensor","[",__}]]],
   True,TestID->"20-RAW-abstract-source"
 ],
 VerificationTest[
   Module[{e=RAYTensor["V",{RAYUp[i]}]*A'[t]},
     SameQ[ToExpression[ToBoxes[e//RAW,StandardForm],StandardForm],e]],
   True,TestID->"21-RAW-copy-paste-roundtrip"
 ],
 VerificationTest[
   SameQ[First[RAW[TraditionalForm[A'[t]]]],A'[t]],
   True,TestID->"22-RAW-strips-traditional"
 ],
 VerificationTest[
   SameQ[First[RAW[MatrixForm[{{A'[t],P[y,z]}}]]],
     {{A'[t],P[y,z]}}],
   True,TestID->"23-RAW-strips-matrix"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYPretty[P[y,z]+Derivative[1,0][P][y,z]],
      StandardForm],TagBox[_FractionBox,"InactiveDTraditional",___]],
   True,TestID->"24-RAYPretty-partial-notation"
 ],
 VerificationTest[
   Head[RAYRicci["dd",2,2]]===Head[RAYRicciScalar[]],
   True,TestID->"25-individual-component-handwritten"
 ],
 VerificationTest[
   Head[RAYNonzeroRicci["dd"]]===Column,
   True,TestID->"26-nonzero-components-still-work"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYNonzeroRicci["dd"],StandardForm],
     TagBox[_FractionBox,"InactiveDTraditional",___]],
   True,TestID->"27-nonzero-components-human-derivatives"
 ],
 VerificationTest[
   Head[RAYReadableTensor[RAYRaw["Ricci","dd"],"Ricci","dd"]]===
     Head[RAYRicci["dd"]],
   True,TestID->"28-user-readable-component-command"
 ],
 VerificationTest[
   Module[{raw=RAYRaw["Ricci","dd"],formatted=RAYRicci["dd"]},
     SameQ[First[formatted],raw]],
   True,TestID->"29-underlying-tensor-unchanged"
 ],
 VerificationTest[
   Module[{s=RAYRaw["RicciScalar"]},
     TrueQ[FullSimplify[s-Tr[
       RAYRaw["Metric","uu"].RAYRaw["Ricci","dd"]]==0]]],
   True,TestID->"30-no-physics-regression"
 ],
 VerificationTest[
   Module[{expr=RAYReadable[A''[t]+A'[t]^2,
      "DerivativeNotation"->"Dot"]},
     !FreeQ[ToBoxes[expr,StandardForm],OverscriptBox["A","."]]],
   True,TestID->"31-readable-dot-command"
 ],
 VerificationTest[
   Module[{expr=RAYReadable[Derivative[0,1][P][y,z]]},
     SameQ[ToExpression[ToBoxes[expr,StandardForm],StandardForm],
       Derivative[0,1][P][y,z]]],
   True,TestID->"32-readable-partial-copy-paste"
 ],
 VerificationTest[
   !StringContainsQ[ToString[ToBoxes[RAYRicciScalar[],
     StandardForm],InputForm],"pretty$"],
   True,TestID->"33-no-private-box-placeholder"
 ],
 VerificationTest[
   SameQ[First[RAW[InputForm[A'[t]]]],A'[t]],
   True,TestID->"34-RAW-inputform-legacy"
 ],
 VerificationTest[
   Module[{g=RAYSymbolicMetric["Hand5",5]},
     AssociationQ[g]],
   True,TestID->"35-abstract-descriptor-still-works"
 ]
};
hhReport=TestReport[hhTests];
hhSummary=<|"Total"->Length[hhTests],
 "Passed"->Length[hhReport[[1]]["TestsSucceededKeys"]],
 "Failed"->Length[hhReport[[1]]["TestsFailedWrongResultsKeys"]]+
 Length[hhReport[[1]]["TestsFailedWithMessagesKeys"]]|>;
hhSummary
