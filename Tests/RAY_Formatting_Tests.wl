(* RAY notebook formatting / RAW regression suite.
   All notebook-formatting checks exercise real MakeBoxes and the Wolfram
   parser, not screenshots. A graphical front end is tested separately. *)
Needs["RAY`"];
ClearAll[a,b,c,d,i,j,t,x,expression,box,formatChecks];

formatChecks={
 VerificationTest[
   Head[ToBoxes[RAYTensor["A",{RAYUp[i]}],StandardForm]]===InterpretationBox,
   True,TestID->"01-standard-interpretation-box"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYTensor["A",{RAYUp[i]}],StandardForm],_SuperscriptBox],
   True,TestID->"02-tensor-upper"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYTensor["B",{RAYDown[i]}],StandardForm],_SubscriptBox],
   True,TestID->"03-tensor-lower"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYTensor["Riemann",
      {RAYUp[a],RAYDown[b],RAYDown[c],RAYDown[d]}],
      StandardForm],_SubsuperscriptBox],
   True,TestID->"04-tensor-mixed"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYTensor["Metric",
      {RAYDown[a],RAYDown[b]}],StandardForm],
     StyleBox["g",___]],True,TestID->"05-metric-name"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYTensor["Ricci",
      {RAYDown[a],RAYDown[b]}],StandardForm],
     StyleBox["R",___]],True,TestID->"06-ricci-name"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYTensor["Einstein",
      {RAYDown[a],RAYDown[b]}],StandardForm],
     StyleBox["G",___]],True,TestID->"07-einstein-name"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYTensor["Weyl",
      {RAYDown[a],RAYDown[b],RAYDown[c],RAYDown[d]}],
      StandardForm],StyleBox["C",___]],True,TestID->"08-weyl-name"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYTensor["Delta",
      {RAYUp[a],RAYDown[b]}],StandardForm],
     StyleBox["\[Delta]",___]],True,TestID->"09-kronecker-delta-name"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYTensor["Shear",
      {RAYDown[a],RAYDown[b]}],StandardForm],
     StyleBox["\[Sigma]",___]],True,TestID->"10-shear-name"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYTensor["Vorticity",
      {RAYDown[a],RAYDown[b]}],StandardForm],
     StyleBox["\[Omega]",___]],True,TestID->"11-vorticity-name"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYDummy[1],StandardForm],_SubscriptBox],
   True,TestID->"12-dummy-typeset"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYNabla[RAYDown[a],
      RAYTensor["A",{RAYUp[b]}]],StandardForm],
      SubscriptBox["\[Del]",_]],True,TestID->"13-lower-nabla"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYNabla[RAYUp[a],
      RAYTensor["A",{RAYDown[b]}]],StandardForm],
      SuperscriptBox["\[Del]",_]],True,TestID->"14-upper-nabla"
 ],
 VerificationTest[
   SameQ[ToExpression[ToBoxes[RAYTensor["A",{RAYUp[i]}],
     StandardForm],StandardForm],RAYTensor["A",{RAYUp[i]}]],
   True,TestID->"15-roundtrip-upper"
 ],
 VerificationTest[
   SameQ[ToExpression[ToBoxes[RAYTensor["Metric",
      {RAYDown[a],RAYDown[b]}],StandardForm],StandardForm],
      RAYTensor["Metric",{RAYDown[a],RAYDown[b]}]],
   True,TestID->"16-roundtrip-metric"
 ],
 VerificationTest[
   SameQ[ToExpression[ToBoxes[
      RAYNabla[RAYDown[a],RAYTensor["V",{RAYUp[b]}]],
      StandardForm],StandardForm],
      RAYNabla[RAYDown[a],RAYTensor["V",{RAYUp[b]}]]],
   True,TestID->"17-roundtrip-nabla"
 ],
 VerificationTest[
   Module[{expr=RAYTensor["A",{RAYUp[i]}]*
      RAYTensor["B",{RAYDown[i]}]-
      RAYTensor["A",{RAYUp[j]}]*
      RAYTensor["B",{RAYDown[j]}]},
     SameQ[ToExpression[ToBoxes[expr,StandardForm],StandardForm],expr]],
   True,TestID->"18-roundtrip-polynomial"
 ],
 VerificationTest[
   Head[RAW[RAYTensor["A",{RAYUp[i]}]]]===InputForm,
   True,TestID->"19-RAW-head"
 ],
 VerificationTest[
   StringContainsQ[ToString[RAW[RAYTensor["A",{RAYUp[i]}]],InputForm],
      "RAYTensor["],
   True,TestID->"20-RAW-syntax"
 ],
 VerificationTest[
   SameQ[RAW[TraditionalForm[1+a]],InputForm[1+a]],
   True,TestID->"21-RAW-traditional"
 ],
 VerificationTest[
   SameQ[RAW[MatrixForm[{{1,2},{3,4}}]],InputForm[{{1,2},{3,4}}]],
   True,TestID->"22-RAW-matrix"
 ],
 VerificationTest[
   SameQ[RAW[TraditionalForm[MatrixForm[{{1,2}}]]],
       InputForm[{{1,2}}]],True,TestID->"23-RAW-nested"
 ],
 VerificationTest[
   SameQ[RAW[TableForm[{{a,b}}]],InputForm[{{a,b}}]],
   True,TestID->"24-RAW-table"
 ],
 VerificationTest[
   Head[RAYPretty[RAYTensor["A",{RAYDown[a]}]]]===TraditionalForm,
   True,TestID->"25-pretty-form"
 ],
 VerificationTest[
   Module[{expr=RAYTensor["A",{RAYUp[i]}]*
       RAYTensor["B",{RAYDown[i]}]},
     SameQ[RAYCanonicalize[expr],RAYCanonicalize[expr//RAW//First]]],
   True,TestID->"26-RAW-original-algebra"
 ],
 VerificationTest[
   Module[{geom=RAYSymbolicMetric["Pretty4",4,
      "Signature"->{-1,1,1,1}]},
     MatchQ[geom["MetricTensor"],
       RAYTensor["Metric",{RAYDown[_],RAYDown[_]}]]],
   True,TestID->"27-symbolic-descriptor-indices"
 ],
 VerificationTest[
   Module[{geom=RAYSymbolicMetric["Pretty4",4]},
     !FreeQ[ToBoxes[geom["RiemannTensor"],StandardForm],
       _SubsuperscriptBox]],
   True,TestID->"28-symbolic-Riemann-typesetting"
 ],
 VerificationTest[
   Module[{g},
     RAYDefineMetric["FormattingFlat",{t,x},
        DiagonalMatrix[{-1,1}]];
     g=RAW[RAYMetric["dd"]];
     SameQ[g,InputForm[DiagonalMatrix[{-1,1}]]]
   ],True,TestID->"29-RAW-existing-display-API"
 ],
 VerificationTest[
   SameQ[RAYRicci["dd"]//RAW,
     InputForm[RAYRaw["Ricci","dd"]]],
   True,TestID->"30-RAW-existing-Ricci"
 ],
 VerificationTest[
   SameQ[ToExpression[ToBoxes[
      RAYTensor["A",{RAYUp[i]}],TraditionalForm],
      TraditionalForm],
       RAYTensor["A",{RAYUp[i]}]],
   True,TestID->"31-roundtrip-traditional"
 ],
 VerificationTest[
   !StringContainsQ[ToString[ToBoxes[
       RAYNabla[RAYDown[a],RAYTensor["B",{RAYDown[b]}]],
       StandardForm],InputForm],"Part["],
   True,TestID->"32-no-part-artifacts"
 ],
 VerificationTest[
   SameQ[RAW[RAYPretty[RAYTensor["A",{RAYUp[i]}]]],
      InputForm[RAYTensor["A",{RAYUp[i]}]]],
   True,TestID->"33-RAW-pretty"
 ],
 VerificationTest[
   SameQ[RAW[InputForm[a+b]],InputForm[a+b]],
   True,TestID->"34-RAW-idempotent"
 ],
 VerificationTest[
   !FreeQ[ToBoxes[RAYTensor["Metric",
       {RAYDown["a"],RAYDown["b"]}],StandardForm],
     RowBox[{"a","b"}]],
   True,TestID->"35-unquoted-string-indices"
 ]
};

formatReport=TestReport[formatChecks];
formatSummary=<|
 "Total"->Length[formatChecks],
 "Passed"->Length[formatReport[[1]]["TestsSucceededKeys"]],
 "Failed"->Length[formatReport[[1]]["TestsFailedWrongResultsKeys"]]+
          Length[formatReport[[1]]["TestsFailedWithMessagesKeys"]]
|>;
formatSummary
